    <Compile Include="..\..\src\hwpPzWall\AppConfig.cs" Link="linked\AppConfig.cs" />
    <Compile Include="..\..\src\hwpPzWall\MonitorInfo.cs" Link="linked\MonitorInfo.cs" />
    <Compile Include="..\..\src\hwpPzWall\Native.cs" Link="linked\Native.cs" />
    <Compile Include="..\..\src\hwpPzWall\Log.cs" Link="linked\Log.cs" />
  </ItemGroup>

</Project>
